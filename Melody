<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#0b0d14" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <title>HumWave Ultra — Поиск песен по напеву</title>
  <style>
    :root {
      --bg-primary: #0b0d14;
      --bg-card: #151926;
      --bg-card-alt: #1c2235;
      --accent-cyan: #00e5ff;
      --accent-violet: #7c4dff;
      --accent-emerald: #00e676;
      --accent-amber: #ffab00;
      --text-main: #f3f6ff;
      --text-muted: #8b95b0;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --radius-lg: 26px;
      --radius-md: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      font-family: 'SamsungOne', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: radial-gradient(circle at 50% 15%, #191f38 0%, var(--bg-primary) 70%);
      color: var(--text-main);
      min-height: 100dvh;
      display: flex;
      justify-content: center;
      overflow-x: hidden;
    }

    /* Контейнер под пропорции Samsung Galaxy S24 Ultra (19.5:9) */
    .app-shell {
      width: 100%;
      max-width: 460px;
      min-height: 100dvh;
      padding: env(safe-area-inset-top, 16px) 18px env(safe-area-inset-bottom, 24px);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* Верхняя шапка в стиле One UI */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 8px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
      box-shadow: 0 0 12px var(--accent-cyan);
    }

    .brand-title {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .brand-badge {
      font-size: 0.7rem;
      background: rgba(124, 77, 255, 0.2);
      color: #b39ddb;
      padding: 3px 8px;
      border-radius: 99px;
      border: 1px solid rgba(124, 77, 255, 0.35);
    }

    .icon-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 8px 12px;
      border-radius: 14px;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.15s ease, background 0.2s;
    }

    .icon-btn:active {
      transform: scale(0.95);
    }

    /* Индикатор текущей ноты и статуса */
    .pitch-hud {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      display: flex;
       flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .hud-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .status-led {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4e566d;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .status-led.active {
      background: var(--accent-emerald);
      box-shadow: 0 0 10px var(--accent-emerald);
    }

    .live-note-box {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .live-note {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--accent-cyan);
      min-width: 44px;
      text-align: right;
    }

    .live-freq {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      min-width: 58px;
    }

    /* Холст визуализации мелодического контура */
    .canvas-wrap {
      width: 100%;
      height: 118px;
      background: #0d101a;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      position: relative;
      overflow: hidden;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    .contour-stats {
      display: flex;
      justify-content: space-between;
      font-size: 0.76rem;
      color: var(--text-muted);
    }

    /* Центральная кнопка прослушивания в стиле Shazam */
    .listen-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 12px 0 6px;
      position: relative;
    }

    .pulse-ring {
      position: relative;
      width: 146px;
      height: 146px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pulse-ring::before,
    .pulse-ring::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid var(--accent-cyan);
      opacity: 0;
      pointer-events: none;
    }

    .pulse-ring.listening::before {
      animation: ripple 1.8s infinite cubic-bezier(0.2, 0.6, 0.35, 1);
    }

    .pulse-ring.listening::after {
      animation: ripple 1.8s infinite 0.9s cubic-bezier(0.2, 0.6, 0.35, 1);
    }

    @keyframes ripple {
      0% { transform: scale(0.95); opacity: 0.75; }
      100% { transform: scale(1.48); opacity: 0; }
    }

    .shazam-btn {
      width: 126px;
      height: 126px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(145deg, #1f2942, #121726);
      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.55),
        inset 0 2px 4px rgba(255, 255, 255, 0.12),
        0 0 0 2px rgba(0, 229, 255, 0.25);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.3, 1.4, 0.6, 1);
      z-index: 2;
    }

    .shazam-btn.active {
      background: linear-gradient(145deg, var(--accent-violet), #0097a7);
      box-shadow:
        0 0 35px rgba(0, 229, 255, 0.45),
        inset 0 2px 6px rgba(255, 255, 255, 0.35);
      transform: scale(1.04);
    }

    .shazam-btn:active {
      transform: scale(0.94);
    }

    .mic-svg {
      width: 38px;
      height: 38px;
      fill: currentColor;
    }

    .btn-label {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .hint-text {
      margin-top: 10px;
      font-size: 0.82rem;
      color: var(--text-muted);
      text-align: center;
      line-height: 1.35;
    }

    /* Панель быстрых действий */
    .quick-actions {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
    }

    .action-chip {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 10px 8px;
      border-radius: 14px;
      font-size: 0.76rem;
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      transition: background 0.2s, transform 0.12s;
    }

    .action-chip:active {
      transform: scale(0.96);
      background: var(--bg-card-alt);
    }

    .action-chip:disabled {
      opacity: 0.4;
      pointer-events: none;
    }

    /* Список найденных совпадений */
    .results-section {
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .section-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .song-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 13px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      transition: transform 0.2s, border-color 0.2s;
    }

    .song-card.top-match {
      background: linear-gradient(135deg, rgba(0, 229, 255, 0.11), rgba(124, 77, 255, 0.11));
      border-color: rgba(0, 229, 255, 0.45);
    }

    .song-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
      flex: 1;
    }

    .song-title {
      font-size: 0.96rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .song-artist {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .song-meta {
      font-size: 0.7rem;
      color: #6fd6ff;
      margin-top: 2px;
    }

    .match-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .score-badge {
      padding: 5px 10px;
      border-radius: 12px;
      font-size: 0.82rem;
      font-weight: 800;
      background: rgba(0, 230, 118, 0.15);
      color: var(--accent-emerald);
      font-variant-numeric: tabular-nums;
    }

    .score-badge.medium {
      background: rgba(255, 171, 0, 0.15);
      color: var(--accent-amber);
    }

    .play-preview-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card-alt);
      color: var(--text-main);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
    }

    /* Модальное окно настроек и добавления своих мелодий */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(5, 7, 12, 0.82);
      backdrop-filter: blur(8px);
      display: none;
      align-items: flex-end;
      justify-content: center;
      z-index: 50;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-sheet {
      width: 100%;
      max-width: 460px;
      background: var(--bg-card);
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      border-top: 1px solid var(--border-subtle);
      padding: 20px 18px 30px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-height: 85dvh;
      overflow-y: auto;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-group label {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .text-input {
      background: #0d101a;
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 0.88rem;
      outline: none;
    }

    .text-input:focus {
      border-color: var(--accent-cyan);
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
      color: #06080e;
      font-weight: 800;
      border: none;
      padding: 12px;
      border-radius: 14px;
      font-size: 0.88rem;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- Шапка -->
    <header class="top-bar">
      <div class="brand">
        <span class="brand-dot"></span>
        <span class="brand-title">HumWave</span>
        <span class="brand-badge">S24 Ultra DSP</span>
      </div>
      <button class="icon-btn" id="openSettingsBtn">
        <span>⚙️ AI / База</span>
      </button>
    </header>

    <!-- HUD: Текущая нота и график мелодического контура -->
    <section class="pitch-hud">
      <div class="hud-header">
        <div class="status-pill">
          <span class="status-led" id="statusLed"></span>
          <span id="statusText">Готов к напеванию</span>
        </div>
        <div class="live-note-box">
          <span class="live-freq" id="liveFreq">0 Hz</span>
          <span class="live-note" id="liveNote">—</span>
        </div>
      </div>

      <div class="canvas-wrap">
        <canvas id="pitchCanvas"></canvas>
      </div>

      <div class="contour-stats">
        <span id="notesCountLabel">Уловлено нот: 0</span>
        <span id="intervalsPreview">Интервалы: ожидание...</span>
      </div>
    </section>

    <!-- Кнопка прослушивания -->
    <section class="listen-zone">
      <div class="pulse-ring" id="pulseRing">
        <button class="shazam-btn" id="listenBtn">
          <svg class="mic-svg" viewBox="0 0 24 24">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z"/>
          </svg>
          <span class="btn-label" id="listenBtnLabel">Напеть</span>
        </button>
      </div>
      <p class="hint-text" id="hintText">
        Нажмите и напевайте мелодию («ммм», «ла-ла» или свист) 5–10 секунд в любой тональности
      </p>
    </section>

    <!-- Быстрые действия -->
    <section class="quick-actions">
      <button class="action-chip" id="playCapturedBtn" disabled>▶️ Мой напев</button>
      <button class="action-chip" id="simulateHumBtn">🧪 Демо-напев</button>
      <button class="action-chip" id="saveCustomBtn" disabled>➕ В базу</button>
    </section>

    <!-- Результаты -->
    <section class="results-section">
      <div class="section-title">
        <span>Подходящие песни по контуру</span>
        <span id="engineModeBadge">Локальный DTW + Контур</span>
      </div>
      <div id="resultsContainer" style="display:flex; flex-direction:column; gap:9px;"></div>
    </section>
  </div>

  <!-- Модальное окно настроек и Gemini API -->
  <div class="modal-backdrop" id="settingsModal">
    <div class="modal-sheet">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="font-size:1.05rem;">Настройки движка и базы</h3>
        <button class="icon-btn" id="closeSettingsBtn">Закрыть ✕</button>
      </div>

      <div class="field-group">
        <label>Ключ Gemini API (необязательно — для облачного поиска из миллионов песен по голосу):</label>
        <input type="password" id="geminiApiKeyInput" class="text-input" placeholder="AIzaSy..." />
      </div>

      <div class="field-group">
        <label>Добавить свой последний напев как новую песню в память телефона:</label>
        <input type="text" id="customSongTitle" class="text-input" placeholder="Название песни (например: Кукла колдуна)" />
        <input type="text" id="customSongArtist" class="text-input" placeholder="Исполнитель (например: Король и Шут)" style="margin-top:6px;" />
        <button class="primary-btn" id="confirmAddSongBtn" style="margin-top:8px;">Сохранить мой напев в базу</button>
      </div>
    </div>
  </div>

  <script>
    /********************************************************************
     * 1. БАЗА МЕЛОДИЧЕСКИХ КОНТУРОВ (Транспозиционно-независимые ноты)
     * Каждая песня задана последовательностью MIDI-нот главной темы/припева
     * Алгоритм сам вычисляет относительные интервалы (Δ полутонов),
     * поэтому угадывает песню независимо от того, насколько низко или
     * высоко поет пользователь.
     ********************************************************************/
    const DEFAULT_MELODY_DB = [
      {
        id: 'zelenoglazoe',
        title: 'Зеленоглазое такси',
        artist: 'Михаил Боярский / Олег Кваша',
        hint: 'Припев: «О-о-о, зеленоглазое такси...»',
        midi: [69, 69, 69, 67, 65, 64, 62, 64, 65, 64, 62, 60, 62]
      },
      {
        id: 'kish_kukla',
        title: 'Кукла колдуна',
        artist: 'Король и Шут',
        hint: 'Вступление / припев',
        midi: [64, 67, 69, 71, 72, 71, 69, 67, 65, 67, 69, 67, 64]
      },
      {
        id: 'kish_lesnik',
        title: 'Лесник (Будь как дома, путник)',
        artist: 'Король и Шут',
        hint: 'Припев: «Будь как дома, путник, я ни в чем не откажу...»',
        midi: [62, 65, 65, 65, 67, 69, 69, 69, 70, 69, 67, 65, 64, 62]
      },
      {
        id: 'kino_gruppa',
        title: 'Группа крови',
        artist: 'Кино (Виктор Цой)',
        hint: 'Припев: «Группа крови на рукаве...»',
        midi: [66, 66, 66, 64, 62, 64, 66, 61, 61, 62, 64, 62, 59]
      },
      {
        id: 'seven_nation',
        title: 'Seven Nation Army',
        artist: 'The White Stripes',
        hint: 'Главный басовый рифф («Пам — пам-пам-пам-пам — пам — пам»)',
        midi: [64, 64, 67, 64, 62, 60, 59]
      },
      {
        id: 'bella_ciao',
        title: 'Bella Ciao',
        artist: 'Народная / La Casa de Papel',
        hint: 'Основная вокальная тема',
        midi: [57, 60, 62, 64, 60, 57, 60, 62, 64, 60, 57, 60, 62, 64, 62, 60, 64, 64, 64]
      },
      {
        id: 'imperial_march',
        title: 'The Imperial March (Darth Vader Theme)',
        artist: 'John Williams',
        hint: 'Марш Империи из Звездных Войн',
        midi: [67, 67, 67, 63, 70, 67, 63, 70, 67, 74, 74, 74, 75, 70, 66, 63, 70, 67]
      },
      {
        id: 'smoke_water',
        title: 'Smoke on the Water',
        artist: 'Deep Purple',
        hint: 'Главный гитарный рифф',
        midi: [62, 65, 67, 62, 65, 68, 67, 62, 65, 67, 65, 62]
      },
      {
        id: 'smells_teen',
        title: 'Smells Like Teen Spirit',
        artist: 'Nirvana',
        hint: 'Вокальная линия припева «Hello, hello, hello, how low»',
        midi: [68, 67, 65, 68, 67, 65, 68, 67, 65, 63, 65]
      },
      {
        id: 'numanuma',
        title: 'Dragostea Din Tei (Ma-ia-hii)',
        artist: 'O-Zone',
        hint: 'Вокальный припев «Нума-нума-ей»',
        midi: [72, 71, 69, 67, 67, 72, 71, 69, 67, 69, 72, 71, 69, 67]
      }
    ];

    // Загрузка базы с учетом пользовательских песен из localStorage
    function loadDatabase() {
      try {
        const saved = localStorage.getItem('humwave_custom_db');
        if (saved) {
          return [...JSON.parse(saved), ...DEFAULT_MELODY_DB];
        }
      } catch (e) {}
      return [...DEFAULT_MELODY_DB];
    }

    let melodyDB = loadDatabase();

    /********************************************************************
     * 2. МУЗЫКАЛЬНАЯ МАТЕМАТИКА И АВТОКОРРЕЛЯЦИЯ (Web Audio API)
     ********************************************************************/
    const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

    function freqToMidi(freq) {
      return 69 + 12 * Math.log2(freq / 440);
    }

    function midiToFreq(midi) {
      return 440 * Math.pow(2, (midi - 69) / 12);
    }

    function midiToNoteName(midi) {
      const rounded = Math.round(midi);
      const name = NOTE_NAMES[((rounded % 12) + 12) % 12];
      const octave = Math.floor(rounded / 12) - 1;
      return `${name}${octave}`;
    }

    // Нормализованная автокорреляция с параболической интерполяцией пика
    function detectPitchAutocorrelation(buffer, sampleRate) {
      const n = buffer.length;
      let rms = 0;
      for (let i = 0; i < n; i++) {
        rms += buffer[i] * buffer[i];
      }
      rms = Math.sqrt(rms / n);
      if (rms < 0.014) return null; // Отсечение тишины и фонового шума

      // Диапазон человеческого напевания и свиста: 75 Гц — 950 Гц
      const minLag = Math.floor(sampleRate / 950);
      const maxLag = Math.min(Math.floor(sampleRate / 75), Math.floor(n / 2));

      let bestLag = -1;
      let bestCorr = 0;
      const corrBuffer = new Float32Array(maxLag + 2);

      for (let lag = minLag; lag <= maxLag; lag++) {
        let sum = 0;
        let normA = 0;
        let normB = 0;
        const limit = n - lag;
        for (let i = 0; i < limit; i++) {
          const a = buffer[i];
          const b = buffer[i + lag];
          sum += a * b;
          normA += a * a;
          normB += b * b;
        }
        const denom = Math.sqrt(normA * normB);
        const corr = denom > 0 ? sum / denom : 0;
        corrBuffer[lag] = corr;

        if (corr > bestCorr) {
          bestCorr = corr;
          bestLag = lag;
        }
      }

      if (bestCorr < 0.62 || bestLag <= minLag || bestLag >= maxLag) {
        return null;
      }

      // Параболическая интерполяция для суб-сэмпловой точности частоты
      const y1 = corrBuffer[bestLag - 1];
      const y2 = corrBuffer[bestLag];
      const y3 = corrBuffer[bestLag + 1];
      const denom = 2 * (2 * y2 - y1 - y3);
      const delta = denom !== 0 ? (y3 - y1) / denom : 0;
      const refinedLag = bestLag + Math.max(-0.5, Math.min(0.5, delta));

      return sampleRate / refinedLag;
    }

    /********************************************************************
     * 3. DTW-АЛГОРИТМ СОПОСТАВЛЕНИЯ МЕЛОДИЧЕСКОГО КОНТУРА
     * Сравнивает:
     *  a) Центрированный профиль высоты (инвариантно к тональности)
     *  b) Последовательность шагов между нотами (Δ полутонов)
     ********************************************************************/
    function extractIntervals(midiSeq) {
      // Схлопываем подряд идущие одинаковые ноты, но сохраняем контур движения
      const dedup = [midiSeq[0]];
      for (let i = 1; i < midiSeq.length; i++) {
        if (Math.abs(midiSeq[i] - dedup[dedup.length - 1]) >= 1) {
          dedup.push(midiSeq[i]);
        }
      }
      const source = dedup.length >= 4 ? dedup : midiSeq;
      const intervals = [];
      for (let i = 1; i < source.length; i++) {
        intervals.push(Math.max(-12, Math.min(12, source[i] - source[i - 1])));
      }
      return intervals;
    }

    function normalizeZeroMean(midiSeq) {
      const mean = midiSeq.reduce((a, b) => a + b, 0) / midiSeq.length;
      return midiSeq.map(n => n - mean);
    }

    // Dynamic Time Warping со свободным входом/выходом (Subsequence DTW)
    function computeDTWDistance(seqA, seqB) {
      const n = seqA.length;
      const m = seqB.length;
      if (n === 0 || m === 0) return Infinity;

      const dp = Array.from({ length: n + 1 }, () => new Float32Array(m + 1).fill(Infinity));
      // Позволяем напеву начаться с любого места мелодии с минимальным штрафом
      for (let j = 0; j <= m; j++) {
        dp[0][j] = j * 0.15;
      }

      for (let i = 1; i <= n; i++) {
        for (let j = 1; j <= m; j++) {
          const cost = Math.abs(seqA[i - 1] - seqB[j - 1]);
          dp[i][j] = cost + Math.min(
            dp[i - 1][j - 1],     // точный шаг
            dp[i - 1][j] + 0.6,   // растяжение напева
            dp[i][j - 1] + 0.6    // пропуск ноты
          );
        }
      }

      // Лучшее совпадение по окончанию фразы пользователя
      let minEndCost = dp[n][m];
      for (let j = Math.max(1, Math.floor(m * 0.5)); j <= m; j++) {
        minEndCost = Math.min(minEndCost, dp[n][j]);
      }
      return minEndCost / n;
    }

    function rankSongsByHumming(capturedMidi) {
      if (!capturedMidi || capturedMidi.length < 4) return [];

      const userZeroMean = normalizeZeroMean(capturedMidi);
      const userIntervals = extractIntervals(capturedMidi);

      const scored = melodyDB.map(song => {
        const songZeroMean = normalizeZeroMean(song.midi);
        const songIntervals = extractIntervals(song.midi);

        const contourDist = computeDTWDistance(userZeroMean, songZeroMean);
        const intervalDist = computeDTWDistance(userIntervals, songIntervals);

        // Комбинированная ошибка в полутонах
        const combinedError = contourDist * 0.45 + intervalDist * 0.55;
        // Перевод ошибки в процент совпадения (0..99%)
        const rawScore = Math.max(12, Math.min(99, Math.round(100 * Math.exp(-combinedError / 2.65))));

        return {
          ...song,
          score: rawScore,
          errorSemitones: combinedError.toFixed(2)
        };
      });

      return scored.sort((a, b) => b.score - a.score);
    }

    /********************************************************************
     * 4. УПРАВЛЕНИЕ МИКРОФОНОМ, СЕГМЕНТАЦИЕЙ НОТ И ВИЗУАЛИЗАЦИЕЙ
     ********************************************************************/
    let audioCtx = null;
    let mediaStream = null;
    let analyser = null;
    let mediaRecorder = null;
    let recordedChunks = [];
    let isListening = false;
    let rafId = null;

    let pitchHistory = [];       // Сырые точки для графика
    let slidingMedianBuf = [];   // Сглаживание скачков
    let segmentedNotes = [];     // Сегментированные устойчивые MIDI-ноты
    let currentCandidate = { midi: null, startTime: 0 };

    const canvas = document.getElementById('pitchCanvas');
    const ctx = canvas.getContext('2d');
    const listenBtn = document.getElementById('listenBtn');
    const listenBtnLabel = document.getElementById('listenBtnLabel');
    const pulseRing = document.getElementById('pulseRing');
    const statusLed = document.getElementById('statusLed');
    const statusText = document.getElementById('statusText');
    const liveNoteEl = document.getElementById('liveNote');
    const liveFreqEl = document.getElementById('liveFreq');
    const notesCountLabel = document.getElementById('notesCountLabel');
    const intervalsPreview = document.getElementById('intervalsPreview');
    const resultsContainer = document.getElementById('resultsContainer');
    const playCapturedBtn = document.getElementById('playCapturedBtn');
    const saveCustomBtn = document.getElementById('saveCustomBtn');

    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 2;
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function vibrateDevice(pattern) {
      if (navigator.vibrate) {
        try { navigator.vibrate(pattern); } catch (e) {}
      }
    }

    function drawPitchContour() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);

      // Сетка полутонов
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.lineWidth = 1;
      for (let y = 20; y < h; y += 24) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      if (pitchHistory.length < 2) return;

      const validMidis = pitchHistory.filter(p => p !== null);
      if (validMidis.length === 0) return;

      const minMidi = Math.min(...validMidis) - 3;
      const maxMidi = Math.max(...validMidis) + 3;
      const range = Math.max(8, maxMidi - minMidi);

      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.shadowColor = '#00e5ff';
      ctx.shadowBlur = 10;

      ctx.beginPath();
      let penDown = false;
      for (let i = 0; i < pitchHistory.length; i++) {
        const val = pitchHistory[i];
        const x = (i / Math.max(1, 140 - 1)) * w;
        if (val === null) {
          penDown = false;
          continue;
        }
        const y = h - 14 - ((val - minMidi) / range) * (h - 28);
        if (!penDown) {
          ctx.moveTo(x, y);
          penDown = true;
        } else {
          ctx.lineTo(x, y);
        }
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    function updateTelemetryUI() {
      notesCountLabel.textContent = `Уловлено нот: ${segmentedNotes.length}`;
      if (segmentedNotes.length >= 2) {
        const ivs = extractIntervals(segmentedNotes).slice(-7)
          .map(v => (v > 0 ? `+${v}` : `${v}`)).join(' ');
        intervalsPreview.textContent = `Контур (Δ): ${ivs}`;
      } else {
        intervalsPreview.textContent = 'Интервалы: пойте четче...';
      }

      if (segmentedNotes.length >= 4) {
        playCapturedBtn.disabled = false;
        saveCustomBtn.disabled = false;
        const ranked = rankSongsByHumming(segmentedNotes);
        renderResults(ranked);
      }
    }

    function processAudioFrame() {
      if (!isListening || !analyser) return;

      const buf = new Float32Array(analyser.fftSize);
      analyser.getFloatTimeDomainData(buf);
      const freq = detectPitchAutocorrelation(buf, audioCtx.sampleRate);
      const now = performance.now();

      if (freq !== null) {
        const rawMidi = freqToMidi(freq);
        slidingMedianBuf.push(rawMidi);
        if (slidingMedianBuf.length > 5) slidingMedianBuf.shift();

        const sorted = [...slidingMedianBuf].sort((a, b) => a - b);
        const smoothedMidi = sorted[Math.floor(sorted.length / 2)];
        const roundedMidi = Math.round(smoothedMidi);

        liveNoteEl.textContent = midiToNoteName(roundedMidi);
        liveFreqEl.textContent = `${Math.round(freq)} Hz`;

        pitchHistory.push(smoothedMidi);
        if (pitchHistory.length > 140) pitchHistory.shift();

        // Сегментация устойчивых нот (фильтр от случайных переходных звуков < 115 мс)
        if (currentCandidate.midi === null || Math.abs(roundedMidi - currentCandidate.midi) >= 1) {
          currentCandidate = { midi: roundedMidi, startTime: now, pushed: false };
        } else if (!currentCandidate.pushed && (now - currentCandidate.startTime) >= 115) {
          // Избегаем дублирования одной и той же тянущейся ноты подряд более 2 раз
          const len = segmentedNotes.length;
          if (len < 2 || !(segmentedNotes[len - 1] === roundedMidi && segmentedNotes[len - 2] === roundedMidi)) {
            segmentedNotes.push(roundedMidi);
            currentCandidate.pushed = true;
            vibrateDevice(10);
            updateTelemetryUI();
          }
        }
      } else {
        liveNoteEl.textContent = '—';
        pitchHistory.push(null);
        if (pitchHistory.length > 140) pitchHistory.shift();
        currentCandidate = { midi: null, startTime: 0, pushed: false };
      }

      drawPitchContour();
      rafId = requestAnimationFrame(processAudioFrame);
    }

    async function startListening() {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          await audioCtx.resume();
        }

        mediaStream = await navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: false
          }
        });

        const source = audioCtx.createMediaStreamSource(mediaStream);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 2048;
        source.connect(analyser);

        // Запись аудио для опционального мультимодального анализа в Gemini API
        recordedChunks = [];
        try {
          mediaRecorder = new MediaRecorder(mediaStream);
          mediaRecorder.ondataavailable = e => {
            if (e.data && e.data.size > 0) recordedChunks.push(e.data);
          };
          mediaRecorder.start();
        } catch (recErr) {}

        isListening = true;
        pitchHistory = [];
        slidingMedianBuf = [];
        segmentedNotes = [];

        vibrateDevice([25, 40, 25]);
        listenBtn.classList.add('active');
        pulseRing.classList.add('listening');
        statusLed.classList.add('active');
        listenBtnLabel.textContent = 'Стоп';
        statusText.textContent = 'Слушаю ваш напев...';

        processAudioFrame();
      } catch (err) {
        statusText.textContent = 'Нет доступа к микрофону (нужен HTTPS или localhost)';
        alert('Для работы микрофона на Samsung S24 Ultra откройте файл через локальный сервер или используйте кнопку «🧪 Демо-напев» для проверки алгоритма.');
      }
    }

    async function stopListening() {
      isListening = false;
      if (rafId) cancelAnimationFrame(rafId);

      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      if (mediaStream) {
        mediaStream.getTracks().forEach(t => t.stop());
      }

      vibrateDevice(35);
      listenBtn.classList.remove('active');
      pulseRing.classList.remove('listening');
      statusLed.classList.remove('active');
      listenBtnLabel.textContent = 'Напеть';
      statusText.textContent = segmentedNotes.length >= 4
        ? `Напев обработан (${segmentedNotes.length} нот)`
        : 'Напето слишком мало нот — попробуйте еще раз';

      // Если введен ключ Gemini API — дополнительно отправляем аудиозапись в Gemini
      const apiKey = localStorage.getItem('humwave_gemini_key');
      if (apiKey && recordedChunks.length > 0 && segmentedNotes.length >= 3) {
        setTimeout(() => queryGeminiAudioAPI(apiKey), 300);
      }
    }

    listenBtn.addEventListener('click', () => {
      if (isListening) {
        stopListening();
      } else {
        startListening();
      }
    });

    /********************************************************************
     * 5. СИНТЕЗАТОР ДЛЯ ПРОСЛУШИВАНИЯ НАПЕВА И МЕЛОДИЙ ИЗ БАЗЫ
     ********************************************************************/
    function playMidiSequence(midiArray, tempoMs = 240) {
      if (!midiArray || midiArray.length === 0) return;
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const now = audioCtx.currentTime;
      midiArray.forEach((midi, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(midiToFreq(midi), now + idx * (tempoMs / 1000));

        gain.gain.setValueAtTime(0.001, now + idx * (tempoMs / 1000));
        gain.gain.exponentialRampToValueAtTime(0.22, now + idx * (tempoMs / 1000) + 0.03);
        gain.gain.exponentialRampToValueAtTime(0.001, now + (idx + 0.9) * (tempoMs / 1000));

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now + idx * (tempoMs / 1000));
        osc.stop(now + (idx + 0.95) * (tempoMs / 1000));
      });
    }

    playCapturedBtn.addEventListener('click', () => {
      vibrateDevice(15);
      playMidiSequence(segmentedNotes, 230);
    });

    // Режим «Демо-напев» — имитирует живое человеческое напевание со сдвигом тональности
    document.getElementById('simulateHumBtn').addEventListener('click', () => {
      if (isListening) stopListening();
      vibrateDevice([15, 30, 15]);

      const randomSong = melodyDB[Math.floor(Math.random() * 5)];
      // Сдвигаем тональность на +3 полутона и добавляем легкую человеческую погрешность
      const transposition = 3;
      segmentedNotes = randomSong.midi.map(m => m + transposition);

      pitchHistory = [];
      segmentedNotes.forEach(m => {
        for (let k = 0; k < 9; k++) {
          pitchHistory.push(m + Math.sin(k * 0.7) * 0.18);
        }
        pitchHistory.push(null);
      });

      statusText.textContent = `Тест: напев в тональности +${transposition} пт`;
      liveNoteEl.textContent = midiToNoteName(segmentedNotes[segmentedNotes.length - 1]);
      drawPitchContour();
      updateTelemetryUI();
      playMidiSequence(segmentedNotes, 210);
    });

    /********************************************************************
     * 6. ОТОБРАЖЕНИЕ РЕЗУЛЬТАТОВ И ОБЛАЧНЫЙ ПОИСК GEMINI AUDIO API
     ********************************************************************/
    function renderResults(songs) {
      resultsContainer.innerHTML = '';
      songs.slice(0, 5).forEach((song, idx) => {
        const card = document.createElement('div');
        card.className = `song-card ${idx === 0 ? 'top-match' : ''}`;

        const badgeClass = song.score >= 72 ? '' : 'medium';
        card.innerHTML = `
          <div class="song-info">
            <div class="song-title">${idx === 0 ? '🏆 ' : ''}${song.title}</div>
            <div class="song-artist">${song.artist}</div>
            <div class="song-meta">${song.hint || `Отклонение контура: ${song.errorSemitones} пт`}</div>
          </div>
          <div class="match-right">
            <span class="score-badge ${badgeClass}">${song.score}%</span>
            <button class="play-preview-btn" title="Прослушать мелодию песни">▶</button>
          </div>
        `;

        card.querySelector('.play-preview-btn').addEventListener('click', () => {
          vibrateDevice(15);
          playMidiSequence(song.midi, 230);
        });

        resultsContainer.appendChild(card);
      });
    }

    // Первичная отрисовка стартового списка
    renderResults(melodyDB.slice(0, 4).map(s => ({ ...s, score: 0, errorSemitones: '—' })));

    // Опциональный запрос к Gemini API с аудиофайлом и контуром
    async function queryGeminiAudioAPI(apiKey) {
      const badge = document.getElementById('engineModeBadge');
      badge.textContent = '⏳ Запрос в Gemini Audio AI...';

      try {
        const blob = new Blob(recordedChunks, { type: 'audio/webm' });
        const base64Audio = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result.split(',')[1]);
          reader.readAsDataURL(blob);
        });

        const intervalsStr = extractIntervals(segmentedNotes).join(', ');
        const response = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                parts: [
                  {
                    inlineData: {
                      mimeType: 'audio/webm',
                      data: base64Audio
                    }
                  },
                  {
                    text: `Пользователь напел мелодию. Извлеченные интервалы в полутонах: [${intervalsStr}]. Определи 3 наиболее вероятные песни (мировые или русскоязычные хиты). Верни строго JSON-массив объектов: [{"title":"...","artist":"...","score":92,"hint":"..."}] без markdown-обертки.`
                  }
                ]
              }]
            })
          }
        );

        const data = await response.json();
        const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
        const cleaned = rawText.replace(/```json|```/g, '').trim();
        const aiSongs = JSON.parse(cleaned);

        if (Array.isArray(aiSongs) && aiSongs.length > 0) {
          badge.textContent = '✨ Gemini Multimodal AI';
          renderResults(aiSongs.map(s => ({ ...s, midi: segmentedNotes })));
        }
      } catch (e) {
        badge.textContent = 'Локальный DTW + Контур';
      }
    }

    /********************************************************************
     * 7. МОДАЛЬНОЕ ОКНО И ДОБАВЛЕНИЕ СВОИХ ПЕСЕН В ПАМЯТЬ ТЕЛЕФОНА
     ********************************************************************/
    const settingsModal = document.getElementById('settingsModal');
    const apiKeyInput = document.getElementById('geminiApiKeyInput');
    apiKeyInput.value = localStorage.getItem('humwave_gemini_key') || '';

    document.getElementById('openSettingsBtn').addEventListener('click', () => {
      settingsModal.classList.add('open');
    });
    document.getElementById('closeSettingsBtn').addEventListener('click', () => {
      localStorage.setItem('humwave_gemini_key', apiKeyInput.value.trim());
      settingsModal.classList.remove('open');
    });
    document.getElementById('saveCustomBtn').addEventListener('click', () => {
      settingsModal.classList.add('open');
      document.getElementById('customSongTitle').focus();
    });

    document.getElementById('confirmAddSongBtn').addEventListener('click', () => {
      const title = document.getElementById('customSongTitle').value.trim();
      const artist = document.getElementById('customSongArtist').value.trim() || 'Моя запись';
      if (!title || segmentedNotes.length < 4) {
        alert('Сначала напойте минимум 4 ноты и введите название песни.');
        return;
      }

      const newEntry = {
        id: 'custom_' + Date.now(),
        title,
        artist,
        hint: `Сохраненный контур (${segmentedNotes.length} нот)`,
        midi: [...segmentedNotes]
      };

      const existingCustom = JSON.parse(localStorage.getItem('humwave_custom_db') || '[]');
      existingCustom.unshift(newEntry);
      localStorage.setItem('humwave_gemini_key', apiKeyInput.value.trim());
      localStorage.setItem('humwave_custom_db', JSON.stringify(existingCustom));

      melodyDB = loadDatabase();
      settingsModal.classList.remove('open');
      updateTelemetryUI();
      vibrateDevice([20, 50, 20]);
    });
  </script>
</body>
